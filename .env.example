# ==============================================================================
# EduPath AI — Multimodal Adaptive Learning Companion
# Configuration Environment Variables
# ==============================================================================

# Core Application Settings
PROJECT_NAME="EduPath AI — Multimodal Adaptive Learning Companion"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="edupath-super-secret-key-change-in-production-entropy-grade"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Storage
DATABASE_URL="sqlite+aiosqlite:///./edupath_multimodal.db"
STORAGE_PATH="./uploads"
VECTOR_STORE_PATH="./vector_store"

# AI Provider Configuration ("gemini", "openai", "anthropic", "auto", "offline")
DEFAULT_AI_PROVIDER="auto"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Grounding & RAG Parameters
RAG_SIMILARITY_THRESHOLD=0.68
GROUNDING_CONFIDENCE_THRESHOLD=0.75
MAX_CONTEXT_CHUNKS=6
ENABLE_HYBRID_BM25=True

# Code Sandbox Security Limits
CODE_RUN_TIMEOUT_SECONDS=4
MAX_CODE_LENGTH=10000
MAX_OUTPUT_BYTES=50000
SANDBOX_MEMORY_LIMIT_MB=128

# Server Configuration
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8000"
